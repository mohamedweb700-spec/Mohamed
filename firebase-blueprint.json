{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific information and settings",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] }
      },
      "required": ["email", "createdAt"]
    },
    "Task": {
      "title": "Daily Task",
      "description": "A task for the user to complete",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the task" },
        "completed": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "completed", "userId", "createdAt"]
    },
    "Reflection": {
      "title": "Daily Reflection",
      "description": "End of day thoughts and notes",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "date", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks"
    },
    "/users/{userId}/reflections/{reflectionId}": {
      "schema": "Reflection",
      "description": "User daily reflections"
    }
  }
}
